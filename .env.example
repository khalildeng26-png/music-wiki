# 阿里云 OSS 部署配置(本地填写,不要提交 —— .env 已在 .gitignore)
# 复制本文件为 .env,填入你自己的值。

# 地域,如华东2(上海)= oss-cn-shanghai ;华北2(北京)= oss-cn-beijing
OSS_REGION=oss-cn-shanghai

# Bucket 名(创建桶时设的名字,全小写)
OSS_BUCKET=music-wiki

# RAM AccessKey(建议用子账号,只给 OSS 读写权限)
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret

# 百度搜索资源平台 · API 推送 token(可选)
# 获取:百度搜索资源平台 → 搜索服务 → 普通收录 → API 推送,接口地址里 token= 后面那串
# 配置后每次 deploy-server.sh 部署完会自动把全站 URL 推给百度
BAIDU_PUSH_TOKEN=你的token

# umami 自托管匿名统计(可选;服务器一次性搭建见 deploy/umami/README.md)
# 配置后全站页面浏览上报到自己的 stats 子域名;两项都不填则构建产物完全不含统计脚本
UMAMI_URL=https://stats.ambermoon.wiki
UMAMI_WEBSITE_ID=umami后台添加网站后拿到的ID
