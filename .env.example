# 阿里云 OSS 部署配置(本地填写,不要提交 —— .env 已在 .gitignore)
# 复制本文件为 .env,填入你自己的值。

# 地域,如华东2(上海)= oss-cn-shanghai ;华北2(北京)= oss-cn-beijing
OSS_REGION=oss-cn-shanghai

# Bucket 名(创建桶时设的名字,全小写)
OSS_BUCKET=music-wiki

# RAM AccessKey(建议用子账号,只给 OSS 读写权限)
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
