---
import { cn } from "@/lib/utils";

import HeadSEO from "@/components/HeadSEO.astro";
import { Header } from "@/components/Header";
import { Footer } from "@/components/Footer";
import { FeedbackWidget } from "@/components/interactive/FeedbackWidget";
import { FooterContact } from "@/components/interactive/FooterContact";
import { Toaster } from "sonner";

const { title, description, ogImage, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <HeadSEO title={title} description={description} ogImage={ogImage} jsonLd={jsonLd} />
    {/* 匿名统计(umami 自托管,搭建见 deploy/umami/):未配置 .env 时完全不渲染,
        本地 dev 与未配置的构建零上报;data-domains 限定只统计本站,
        防止别人拿到 Website ID 在别的站刷假数据 */}
    {import.meta.env.UMAMI_URL && import.meta.env.UMAMI_WEBSITE_ID && (
      <script
        is:inline
        defer
        src={`${import.meta.env.UMAMI_URL}/script.js`}
        data-website-id={import.meta.env.UMAMI_WEBSITE_ID}
        data-domains="ambermoon.wiki"
      />
    )}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          const dark = stored ? stored === "dark" : prefersDark;
          document.documentElement.classList.toggle("dark", dark);
        } catch {}
      })();
    </script>
    <script is:inline>
      // 老内核兜底:百度App等内置浏览器内核常停在 Chromium <111,不支持
      // @layer/oklch/color-mix(Tailwind v4 的硬门槛),整套现代样式会被整块丢弃
      // → 白底黑字。检测到时切换 /legacy/basic.css 基础排版并加提示条。
      (() => {
        try {
          const modern =
            window.CSS &&
            CSS.supports &&
            CSS.supports("color", "oklch(0.7 0.1 200)") &&
            CSS.supports("color", "color-mix(in srgb, red, blue)");
          if (modern) return;
          document.documentElement.classList.add("legacy");
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = "/legacy/basic.css";
          document.head.appendChild(link);
          const addBanner = () => {
            const bar = document.createElement("div");
            bar.className = "legacy-banner";
            bar.innerHTML =
              "当前浏览器内核较旧,已切换基础排版 · 用 Chrome 或系统浏览器打开可获得完整体验";
            document.body.insertBefore(bar, document.body.firstChild);
          };
          if (document.body) addBanner();
          else document.addEventListener("DOMContentLoaded", addBanner);
        } catch {}
      })();
    </script>
  </head>
  <body
    class={cn(
      "group/body overscroll-none antialiased [--footer-height:calc(var(--spacing)*14)] [--header-height:calc(var(--spacing)*14)] xl:[--footer-height:calc(var(--spacing)*24)]",
    )}
  >
    <div class="bg-background relative z-10 flex min-h-svh flex-col">
      <Header client:load />
      <FeedbackWidget client:load />
      <main class="flex flex-1 flex-col">
        <slot />
      </main>
      <Footer>
        <FooterContact client:visible />
      </Footer>
    </div>
    <Toaster client:load />
    <script is:inline>
      // 滚动入场:.reveal 进入视口时加 is-visible(尊重系统减少动态设置)
      (() => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const io = new IntersectionObserver(
          (es) =>
            es.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.08 },
        );
        document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
