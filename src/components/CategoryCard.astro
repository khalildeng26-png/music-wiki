---
import type { Category } from "@/lib/categories";

const { category } = Astro.props as { category: Category };
---

<a
  href={`/categories/${category.id}`}
  class="group flex flex-col gap-3 rounded-xl border bg-card p-5 transition hover:border-signature/50 hover:shadow-sm"
>
  <div class="text-base font-semibold">{category.label}</div>
  <div class="text-sm text-muted-foreground">{category.desc}</div>
</a>
