---
// 签名视觉元素:五线谱(从左到右渐隐)+ 真正的符头( eighth/quarter notes,纯 SVG)
const { class: className = "" } = Astro.props;
const fadeId = "stafffade-" + Math.random().toString(36).slice(2, 8);
---

<div aria-hidden="true" class:list={[className]}>
  <svg viewBox="0 0 160 46" class="block w-full" fill="none">
    <defs>
      <linearGradient id={fadeId} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="currentColor" stop-opacity="1" />
        <stop offset="0.72" stop-color="currentColor" stop-opacity="0.4" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </linearGradient>
    </defs>

    <!-- 五线(渐隐) -->
    <line x1="0" y1="10" x2="160" y2="10" stroke={`url(#${fadeId})`} stroke-width="1.2" />
    <line x1="0" y1="16" x2="160" y2="16" stroke={`url(#${fadeId})`} stroke-width="1.2" />
    <line x1="0" y1="22" x2="160" y2="22" stroke={`url(#${fadeId})`} stroke-width="1.2" />
    <line x1="0" y1="28" x2="160" y2="28" stroke={`url(#${fadeId})`} stroke-width="1.2" />
    <line x1="0" y1="34" x2="160" y2="34" stroke={`url(#${fadeId})`} stroke-width="1.2" />

    <!-- 八分音符(下加一间,符干向上+符尾) -->
    <g fill="currentColor">
      <ellipse cx="30" cy="34" rx="4.6" ry="3.2" transform="rotate(-18 30 34)" />
      <rect x="33.3" y="11.5" width="1.7" height="22" rx="0.85" />
      <path
        d="M35,11.5 C41.2,13.2 42.8,19 39.2,24.6 C40.8,19.4 38.6,15.2 35,14.3 Z"
      />
    </g>

    <!-- 四分音符(第三线,符干向下) -->
    <g fill="currentColor">
      <ellipse cx="66" cy="22" rx="4.6" ry="3.2" transform="rotate(-18 66 22)" />
      <rect x="61.1" y="22" width="1.7" height="20" rx="0.85" />
    </g>

    <!-- 八分音符(第二线,符干向上+符尾,略淡) -->
    <g fill="currentColor" opacity="0.85">
      <ellipse cx="96" cy="28" rx="4.6" ry="3.2" transform="rotate(-18 96 28)" />
      <rect x="99.3" y="9.5" width="1.7" height="18" rx="0.85" />
      <path
        d="M101,9.5 C107.2,11.2 108.8,17 105.2,22.6 C106.8,17.4 104.6,13.2 101,12.3 Z"
      />
    </g>
  </svg>
</div>
