---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaffLines from "@/components/StaffLines.astro";
import ShareButton from "@/components/interactive/ShareButton";
import RandomEntryButton from "@/components/interactive/RandomEntryButton";
import { categoryByLabel, catColor } from "@/lib/categories";

export async function getStaticPaths() {
  const entries = await getCollection("entries", (e) => !e.data.draft);
  return entries.map((e) => ({
    params: { slug: e.id },
    props: { entry: e, allEntries: entries },
  }));
}

const { entry, allEntries } = Astro.props;
const { Content, headings } = await render(entry);

// 目录只收 H2(H3 是 FAQ 问题,进来会刷屏);小节太少的短词条不出目录
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;

const entryMap = new Map(allEntries.map((e) => [e.id, e]));
const related = entry.data.related
  .map((id) => entryMap.get(id))
  .filter(Boolean) as typeof allEntries;

const allPaths = await getCollection("paths", (p) => !p.data.draft);
const inPaths = allPaths
  .filter((p) => p.data.steps.includes(entry.id))
  .map((p) => {
    const i = p.data.steps.indexOf(entry.id);
    return {
      p,
      step: i + 1,
      total: p.data.steps.length,
      prev: p.data.steps[i - 1],
      next: p.data.steps[i + 1],
    };
  });

const cat = categoryByLabel[entry.data.category];

const entryURL = new URL(`/entries/${entry.id}`, Astro.site).toString();
const headline = entry.data.titleEn
  ? `${entry.data.title} ${entry.data.titleEn}`
  : entry.data.title;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline,
    description: entry.data.summary,
    url: entryURL,
    mainEntityOfPage: entryURL,
    articleSection: entry.data.category,
    inLanguage: "zh-CN",
    publisher: {
      "@type": "Organization",
      name: "橙月Wiki",
      url: "https://ambermoon.wiki",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "首页", item: "https://ambermoon.wiki/" },
      { "@type": "ListItem", position: 2, name: cat.label, item: `https://ambermoon.wiki/categories/${cat.id}` },
      { "@type": "ListItem", position: 3, name: entry.data.title },
    ],
  },
  ...(entry.data.faq?.length
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: entry.data.faq.map((f) => ({
            "@type": "Question",
            name: f.q,
            acceptedAnswer: { "@type": "Answer", text: f.a },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={`${entry.data.title} · 橙月Wiki`}
  description={entry.data.summary}
  ogImage={`/og/${entry.id}.png`}
  type="article"
  jsonLd={jsonLd}
>
  <article data-pagefind-body class="container py-12 max-w-3xl">
    <nav class="text-sm text-muted-foreground">
      <a href="/" class="hover:text-signature">首页</a>
      <span class="mx-1">/</span>
      <a href={`/categories/${cat.id}`} class="hover:text-signature">{cat.label}</a>
    </nav>

    {
      inPaths.map(({ p, step, total, prev, next }) => (
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 rounded-lg border border-signature/30 bg-signature/5 px-4 py-3 text-sm">
          <span>你在路线</span>
          <a href={`/paths/${p.id}`} class="font-medium text-signature-ink hover:underline">
            {p.data.title}
          </a>
          <span class="text-muted-foreground">· 第 {step} / {total} 步</span>
          <span class="ml-auto flex gap-3">
            {prev && (
              <a href={`/entries/${prev}`} class="text-muted-foreground hover:text-signature">← 上一步</a>
            )}
            {next && (
              <a href={`/entries/${next}`} class="text-muted-foreground hover:text-signature">下一步 →</a>
            )}
          </span>
        </div>
      ))
    }

    <h1 class="mt-6 text-4xl font-display font-bold tracking-tight">
      {entry.data.title}
      {entry.data.titleEn && <span class="ml-3 text-2xl font-medium text-muted-foreground md:text-3xl">{entry.data.titleEn}</span>}
    </h1>
    <p class="mt-3 text-lg text-muted-foreground">{entry.data.summary}</p>
    <div class="mt-4 flex flex-wrap gap-2 text-xs">
      <span
        class="inline-flex items-center rounded-md bg-signature/10 px-2 py-0.5 font-medium text-signature-ink"
        style={`--cat:${catColor(cat.hue)};--cat-d:${catColor(cat.hue, "dark")}`}
      >
        <span
          aria-hidden="true"
          class="mr-1 inline-block size-1.5 rounded-full bg-(--cat) dark:bg-(--cat-d)"
        />
        {entry.data.category}
      </span>
      {
        entry.data.tags.map((t) => (
          <span class="rounded-md bg-muted px-2 py-0.5 text-muted-foreground">#{t}</span>
        ))
      }
    </div>

    <StaffLines class="mt-8 w-40 text-signature/40" />

    {
      showToc && (
        <>
          {/* 移动端:正文前的折叠目录,不挡阅读流 */}
          <details
            class="mt-8 rounded-lg border bg-card px-4 py-3 xl:hidden"
            data-pagefind-ignore
          >
            <summary class="cursor-pointer text-sm font-medium">
              本页内容 · {toc.length} 节
            </summary>
            <ul class="mt-2.5 space-y-1.5 text-sm">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-muted-foreground hover:text-signature-ink">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </details>
          {/* 桌面 xl 起:右 gutter 固定目录(正文 max-w-3xl 居中后,两侧留白正好容纳);
              条目少/窗口不够宽时不出现,绝不挤压正文。
              注意(脆点,后续应容器化):right 算式里的 24rem=正文 max-w-3xl 的一半、
              13rem=目录宽 w-52、2rem=栏间距——改正文宽度或目录宽度时必须同步改这里,
              否则会错位且无任何报错。容器化方案:article 改 xl:grid 双列,目录进第二列。 */}
          <aside
            class="hidden xl:fixed xl:top-24 xl:right-[max(1.5rem,calc(50%-24rem-13rem-2rem))] xl:block xl:w-52"
            data-pagefind-ignore
          >
            <nav aria-label="本页目录">
              <p class="text-xs font-medium tracking-wide text-muted-foreground">本页内容</p>
              <ul class="mt-3 space-y-2 text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      data-toc={h.slug}
                      class="toc-link -ml-px block border-l-2 border-transparent pl-3 text-muted-foreground transition hover:text-foreground"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        </>
      )
    }

    <div class="prose dark:prose-invert mt-8 max-w-none">
      <Content />
    </div>

    <!-- 读完正文,顺着路线直接去下一节(不用滚回顶部或返回路线页) -->
    {
      inPaths.map(({ p, step, total, prev, next }) => {
        const prevE = prev ? entryMap.get(prev) : undefined;
        const nextE = next ? entryMap.get(next) : undefined;
        return nextE ? (
          <section class="not-prose mt-12">
            <a
              href={`/entries/${next}`}
              class="group block rounded-xl border border-signature/40 bg-signature/5 p-5 transition hover:border-signature hover:shadow-md sm:p-6"
            >
              <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <span class="font-medium text-signature-ink">{p.data.title}</span>
                <span aria-hidden="true">·</span>
                <span>第 {step} / {total} 节读完</span>
              </div>
              <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="text-xl font-bold tracking-tight transition-colors group-hover:text-signature sm:text-2xl">
                  下一节:{nextE.data.title}
                </span>
                <span class="text-signature transition-transform group-hover:translate-x-1" aria-hidden="true">
                  →
                </span>
              </div>
              <div class="mt-1.5 line-clamp-2 text-sm text-muted-foreground">{nextE.data.summary}</div>
            </a>
            <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-muted-foreground">
              {prevE && (
                <a href={`/entries/${prev}`} class="hover:text-signature">← 上一节:{prevE.data.title}</a>
              )}
              <a href={`/paths/${p.id}`} class="hover:text-signature">回到路线总览</a>
            </div>
          </section>
        ) : (
          <section class="not-prose mt-12 rounded-xl border border-signature/40 bg-signature/5 p-6 text-center sm:p-8">
            <div class="text-sm font-medium text-signature-ink">路线完成</div>
            <div class="mt-1.5 text-xl font-bold tracking-tight sm:text-2xl">
              你读完了「{p.data.title}」全部 {total} 节
            </div>
            <div class="mt-5 flex flex-wrap justify-center gap-3">
              <a
                href="/paths"
                class="rounded-full bg-primary px-5 py-2 text-sm text-primary-foreground transition hover:opacity-90"
              >
                看看其他路线 →
              </a>
              <a
                href={`/paths/${p.id}`}
                class="rounded-full border px-5 py-2 text-sm transition hover:border-signature/50 hover:text-signature"
              >
                回到本路线
              </a>
            </div>
          </section>
        );
      })
    }

    {
      entry.data.faq?.length > 0 && (
        <section class="not-prose mt-16 border-t pt-8">
          <h2 class="text-xl font-display font-semibold">常见问题</h2>
          <div class="mt-4 space-y-5">
            {entry.data.faq.map((f) => (
              <div>
                <h3 class="font-medium">{f.q}</h3>
                <p class="mt-1 text-muted-foreground">{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="not-prose mt-16 border-t pt-8">
          <h2 class="text-xl font-display font-semibold">相关词条</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {related.map((r) => (
              <a
                href={`/entries/${r.id}`}
                class="group rounded-lg border bg-card p-4 transition hover:-translate-y-0.5 hover:border-signature/50 hover:shadow-md"
              >
                <div class="font-medium group-hover:text-signature">
                  {r.data.title}
                  {r.data.titleEn && <span class="ml-1.5 text-sm font-normal text-muted-foreground">{r.data.titleEn}</span>}
                </div>
                <div class="mt-1 text-sm text-muted-foreground">{r.data.summary}</div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <!-- 读完的行动条:分享 / 随机逛一篇 -->
    <section class="not-prose mt-12 flex flex-wrap items-center gap-x-5 gap-y-3 rounded-xl border bg-card p-4">
      <ShareButton client:load title={entry.data.title} />
      <RandomEntryButton
        client:load
        slugs={allEntries.map((e) => e.id)}
        exclude={entry.id}
        label="随机看一篇 →"
      />
      <span class="ml-auto text-xs text-muted-foreground">读完随手一转,是对这本百科最大的帮助</span>
    </section>
  </article>

  {/* 目录当前小节高亮:视口上部命中的 H2 对应链接上色 */}
  <script is:inline>
    (() => {
      const links = document.querySelectorAll("a[data-toc]");
      if (!links.length) return;
      const bySlug = new Map();
      links.forEach((l) => bySlug.set(l.getAttribute("data-toc"), l));
      const heads = Array.from(document.querySelectorAll(".prose h2[id]")).filter((h) =>
        bySlug.has(h.id),
      );
      if (!heads.length) return;
      let cur = null;
      const activate = (id) => {
        if (id === cur) return;
        cur = id;
        bySlug.forEach((l) => l.classList.remove("is-active"));
        const link = bySlug.get(id);
        if (link) link.classList.add("is-active");
      };
      const io = new IntersectionObserver(
        (es) => {
          for (const e of es) if (e.isIntersecting) activate(e.target.id);
        },
        { rootMargin: "-10% 0px -75% 0px" },
      );
      heads.forEach((h) => io.observe(h));
    })();
  </script>
</BaseLayout>
