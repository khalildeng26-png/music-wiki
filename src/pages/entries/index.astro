---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { categories } from "@/lib/categories";

const entries = (await getCollection("entries", (e) => !e.data.draft)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<BaseLayout title="全部词条 · 音乐百科" description="按分类浏览全部词条。">
  <section class="container py-12">
    <h1 class="text-3xl font-bold tracking-tight">全部词条</h1>
    <p class="mt-2 text-muted-foreground">共 {entries.length} 条 · 按分类浏览</p>

    {
      categories.map((cat) => {
        const items = entries.filter((e) => e.data.category === cat.label);
        if (items.length === 0) return null;
        const Icon = cat.icon;
        return (
          <div class="mt-12">
            <div class="flex items-center gap-2">
              <Icon className="size-5 text-signature" />
              <h2 class="text-xl font-semibold">{cat.label}</h2>
              <span class="text-sm text-muted-foreground">{items.length}</span>
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((e) => (
                <a
                  href={`/entries/${e.id}`}
                  class="group flex flex-col gap-1.5 rounded-xl border bg-card p-4 transition hover:border-signature/50"
                >
                  <div class="font-medium group-hover:text-signature">{e.data.title}</div>
                  <div class="line-clamp-2 text-sm text-muted-foreground">{e.data.summary}</div>
                </a>
              ))}
            </div>
          </div>
        );
      })
    }
  </section>
</BaseLayout>
