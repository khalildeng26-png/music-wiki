---
import { getCollection, render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaffLines from "@/components/StaffLines.astro";

export async function getStaticPaths() {
  const [paths, entries] = await Promise.all([
    getCollection("paths", (p) => !p.data.draft),
    getCollection("entries", (e) => !e.data.draft),
  ]);
  const entryMap = new Map(entries.map((e) => [e.id, e]));
  return paths.map((p) => ({
    params: { slug: p.id },
    props: { path: p, entryMap },
  }));
}

const { path, entryMap } = Astro.props;
const { Content } = await render(path);
const steps = path.data.steps
  .map((id) => entryMap.get(id))
  .filter(Boolean) as NonNullable<ReturnType<typeof entryMap.get>>[];
---

<BaseLayout
  title={`${path.data.title} · 橙月Wiki`}
  description={path.data.description}
  ogImage={`/og/${path.id}.png`}
>
  <section class="container py-12 max-w-3xl">
    <nav class="text-sm text-muted-foreground">
      <a href="/" class="hover:text-signature">首页</a>
      <span class="mx-1">/</span>
      <a href="/paths" class="hover:text-signature">学习路线</a>
    </nav>

    <div class="mt-4 flex items-center gap-3">
      <div class="flex flex-col items-center justify-center rounded-lg bg-signature/10 px-3 py-1.5 text-signature-ink">
        <span class="text-2xl font-bold leading-none">{steps.length}</span>
        <span class="text-xs">步</span>
      </div>
      <h1 class="text-3xl font-display font-bold tracking-tight">{path.data.title}</h1>
    </div>
    <p class="mt-4 text-lg text-muted-foreground">{path.data.description}</p>

    {
      path.data.plan && (
        <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border bg-card px-3 py-1 text-xs text-muted-foreground">
          总练习量:{path.data.plan.total}
        </p>
      )
    }

    {
      steps.length > 0 && (
        <div class="mt-6">
          <a
            href={`/entries/${steps[0].id}`}
            class="inline-flex items-center gap-1.5 rounded-full bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition hover:opacity-90 active:scale-95"
          >
            从第 1 步开始 →
          </a>
        </div>
      )
    }

    {
      path.body?.trim() && (
        <div class="prose dark:prose-invert mt-6 max-w-none">
          <Content />
        </div>
      )
    }

    {
      path.data.plan && path.data.plan.milestones.length === steps.length && (
        <div class="mt-10 not-prose">
          <h2 class="text-xl font-display font-semibold">练习计划</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            路线不只是阅读顺序:每步练多少、做到什么才算过关,照下表执行。标准做不到就再练,不丢人——所有教吉他的老师都这么要求。
          </p>
          <div class="mt-4 overflow-x-auto rounded-xl border bg-card">
            <table class="w-full min-w-125 text-sm">
              <thead>
                <tr class="border-b bg-muted/40 text-left text-xs text-muted-foreground">
                  <th class="px-4 py-2.5 font-medium">步</th>
                  <th class="px-4 py-2.5 font-medium">内容</th>
                  <th class="px-4 py-2.5 font-medium">练习量</th>
                  <th class="px-4 py-2.5 font-medium">过关标准</th>
                </tr>
              </thead>
              <tbody>
                {steps.map((e, i) => (
                  <tr class="border-b last:border-0 align-top">
                    <td class="px-4 py-3 font-mono tabular-nums text-muted-foreground">{i + 1}</td>
                    <td class="px-4 py-3">
                      <a href={`/entries/${e.id}`} class="font-medium hover:text-signature">
                        {e.data.title}
                      </a>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-muted-foreground">
                      {path.data.plan!.milestones[i].days}
                    </td>
                    <td class="px-4 py-3 text-muted-foreground">{path.data.plan!.milestones[i].pass}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )
    }

    <StaffLines class="mt-10 w-40 text-signature/40" />

    <ol class="mt-8 space-y-3">
      {
        steps.map((e, i) => (
          <li>
            <a
              href={`/entries/${e.id}`}
              class="group flex items-center gap-4 rounded-xl border bg-card p-4 transition hover:border-signature/50"
            >
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-signature/10 text-sm font-bold text-signature-ink">
                {i + 1}
              </span>
              <div class="flex-1">
                <div class="font-medium group-hover:text-signature">
                  {e.data.title}
                  {e.data.titleEn && <span class="ml-1.5 text-sm font-normal text-muted-foreground">{e.data.titleEn}</span>}
                </div>
                <div class="text-sm text-muted-foreground">{e.data.summary}</div>
              </div>
              <span class="text-xs text-muted-foreground">{e.data.category}</span>
            </a>
          </li>
        ))
      }
    </ol>

    {
      path.data.next && path.data.next.length > 0 && (
        <section class="not-prose mt-12 border-t pt-8">
          <h2 class="text-xl font-display font-semibold">走完之后</h2>
          <p class="mt-1 text-sm text-muted-foreground">入门只是开始,三个方向任选:</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {path.data.next
              .map((id) => entryMap.get(id))
              .filter(Boolean)
              .map((e) => (
                <a
                  href={`/entries/${e!.id}`}
                  class="group rounded-lg border bg-card p-4 transition hover:-translate-y-0.5 hover:border-signature/50 hover:shadow-md"
                >
                  <div class="font-medium group-hover:text-signature">{e!.data.title}</div>
                  <div class="mt-1 line-clamp-2 text-sm text-muted-foreground">{e!.data.summary}</div>
                </a>
              ))}
          </div>
        </section>
      )
    }
  </section>
</BaseLayout>
