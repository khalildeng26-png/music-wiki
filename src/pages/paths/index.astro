---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const paths = await getCollection("paths", (p) => !p.data.draft);
---

<BaseLayout title="学习路线 · 橙月Wiki" description="精选学习路线,循序渐进。">
  <section class="container py-12 max-w-3xl">
    <h1 class="text-3xl font-bold tracking-tight">学习路线</h1>
    <p class="mt-2 text-muted-foreground">
      把词条串成循序渐进的路径,跟着走完就能掌握一个主题。
    </p>
    <div class="mt-8 grid gap-4">
      {
        paths.map((p) => (
          <a
            href={`/paths/${p.id}`}
            class="group rounded-xl border bg-card p-6 transition hover:border-signature/50"
          >
            <div class="flex items-center gap-3">
              <div class="flex flex-col items-center justify-center rounded-lg bg-signature/10 px-3 py-1.5 text-signature">
                <span class="text-xl font-bold leading-none">{p.data.steps.length}</span>
                <span class="text-[10px]">步</span>
              </div>
              <div class="text-xl font-semibold group-hover:text-signature">{p.data.title}</div>
            </div>
            <p class="mt-3 text-sm text-muted-foreground">{p.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
