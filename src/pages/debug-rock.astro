---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { GENRES } from "@/lib/genrePatterns";
import StyleDemo from "@/components/interactive/StyleDemo";
import type { Pattern, PatternTrack } from "@/components/interactive/audio";

// 摇滚逐轨排查页:把 GENRES.rock 的三轨拆开独奏,定位用户听到的「卡塔卡塔」声源。
const rock = GENRES.rock.pattern;
const guitar = rock.tracks[0];
const bass = rock.tracks[1];
const drums = rock.tracks[2] as Extract<PatternTrack, { kind: "drums" }>;

const kickSnare: PatternTrack = {
  ...drums,
  events: drums.events.filter((e) => e.hit === "kick" || e.hit === "snare"),
};
const hatsOnly: PatternTrack = {
  ...drums,
  events: drums.events.filter((e) => e.hit === "hihat"),
};
const openhatOnly: PatternTrack = {
  ...drums,
  events: drums.events.filter((e) => e.hit === "openhat"),
};

const mk = (t: PatternTrack): Pattern => ({ ...rock, tracks: [t] });
---

<BaseLayout title="摇滚逐轨排查 · 橙月Wiki" description="逐轨独奏,定位异响声源">
  <section class="container py-12 max-w-3xl">
    <h1 class="text-2xl font-display font-bold tracking-tight">摇滚逐轨排查</h1>
    <p class="mt-2 text-muted-foreground">
      逐个点开听:哪一个里能听到「卡塔卡塔」的快速声响?记住编号告诉我。
    </p>
    <div class="mt-8 space-y-4">
      <StyleDemo client:visible title="① 电吉他(和弦轨)" hint="只有吉他" pattern={mk(guitar)} />
      <StyleDemo client:visible title="② 贝斯(根音轨)" hint="只有贝斯" pattern={mk(bass)} />
      <StyleDemo client:visible title="③ 底鼓 + 军鼓" hint="只有这两件鼓" pattern={mk(kickSnare)} />
      <StyleDemo client:visible title="④ 踩镲(闭镲)" hint="只有踩镲" pattern={mk(hatsOnly)} />
      <StyleDemo client:visible title="⑤ 开镲(仅开头一下)" hint="只有开镲" pattern={mk(openhatOnly)} />
      <StyleDemo client:visible title="⑥ 完整版对照" hint="全部轨道" pattern={rock} />
    </div>
  </section>
</BaseLayout>
