---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StaffLines from "@/components/StaffLines.astro";
import { getCollection } from "astro:content";
import { categories, catColor } from "@/lib/categories";
import HomeSearch from "@/components/interactive/HomeSearch";
import Piano from "@/components/interactive/Piano";
import PlayableWord from "@/components/interactive/PlayableWord";
import RandomEntryButton from "@/components/interactive/RandomEntryButton";
import DailyEntry from "@/components/interactive/DailyEntry";
import type { PlayableCard } from "@/components/interactive/PlayableCards";
import MelodyStyles from "@/components/interactive/MelodyStyles";
import GenreQuiz from "@/components/interactive/GenreQuiz";

const entries = await getCollection("entries", (e) => !e.data.draft);
const paths = await getCollection("paths", (p) => !p.data.draft);
const entryMap = new Map(entries.map((e) => [e.id, e]));

// 手工精选 + 声音签名:每张卡的就地试听内容
const FEATURED: PlayableCard[] = [
  {
    href: "/entries/staff-notation",
    title: "五线谱",
    titleEn: "Staff Notation",
    category: "记谱",
    summary: "五条线怎么装下所有音乐?看完这篇,谱子不再是天书。",
    sig: { kind: "notes", notes: ["C4", "D4", "E4", "F4", "G4"] },
    sigNote: "正在听:C–D–E–F–G 逐级上行,在五线谱上正好一线一间交替往上爬。",
  },
  {
    href: "/entries/interval",
    title: "音程",
    titleEn: "Interval",
    category: "乐理",
    summary: "两个音的距离决定情绪:大三度明亮,小三度忧伤。",
    sig: { kind: "notes", notes: ["C4", "E4", "C4", "Eb4"] },
    sigNote: "正在听:大三度(明亮)对照小三度(暗淡)——同一起点,距离差半音,情绪就变了。",
  },
  {
    href: "/entries/pitch-training",
    title: "音准",
    titleEn: "Pitch Training",
    category: "唱法",
    summary: "开麦克风唱一个音,实时看音名与偏差——跑调不可怕,看不见才可怕。",
    sig: { kind: "notes", notes: ["A4"], dur: 0.9 },
    sigNote: "正在听:标准音 A4(440Hz)——乐团调音、校音器对的那个「la」。试着跟它唱齐。",
  },
  {
    href: "/entries/scale",
    title: "音阶",
    titleEn: "Scale",
    category: "乐理",
    summary: "同一个 C,换成五声音阶立刻中国风。选着听,差别立现。",
    sig: { kind: "notes", notes: ["C4", "D4", "E4", "G4", "A4", "C5"] },
    sigNote: "正在听:C 五声音阶——去掉 fa、si 两个半音,「中国风」就出来了。",
  },
  {
    href: "/entries/tempo",
    title: "速度",
    titleEn: "Tempo",
    category: "乐理",
    summary: "60 到 180 BPM 差多少?拖一下滑块,耳朵马上懂。",
    sig: { kind: "notes", notes: ["C5", "C5", "C5", "C5"], dur: 0.09, gap: 0.41 },
    sigNote: "正在听:每秒一拍(120 BPM)——心里跟着数,再进词条拖滑块对比。",
  },
  {
    href: "/entries/church-modes",
    title: "教会调式",
    titleEn: "Church Modes",
    category: "乐理",
    summary: "七种中世纪'口味'——流行歌都在偷偷用 Dorian 和 Mixolydian。",
    sig: { kind: "notes", notes: ["D4", "F4", "G4", "A4", "D5"] },
    sigNote: "正在听:以 D 为家的小调色彩乐句;词条里七种调式各自「扭」其中一个音,口味全变。",
  },
  {
    href: "/entries/chord-symbols",
    title: "和弦标记",
    titleEn: "Chord Symbols",
    category: "记谱",
    summary: "C、C7、Cadd9 这些字母密码,一篇全破译。",
    sig: { kind: "chords", chords: [["C4", "E4", "G4", "Bb4"]] },
    sigNote: "正在听:C7(C–E–G–B♭)——里面那个三全音让它「痒着想解决」,这就是属七的驱动力。",
  },
  {
    href: "/entries/pop-progressions",
    title: "流行和弦进行",
    titleEn: "Pop Progressions",
    category: "和声",
    summary: "为什么上万首歌用同一套和弦?听完这四句你就懂了。",
    sig: {
      kind: "chords",
      chords: [["C4", "E4", "G4"], ["G3", "B3", "D4"], ["A3", "C4", "E4"], ["F3", "A3", "C4"]],
    },
    sigNote: "正在听:I–V–vi–IV(1564)——上万首流行歌共用的开头;4536251 在词条里等你。",
  },
  {
    href: "/entries/blues",
    title: "布鲁斯",
    titleEn: "Blues",
    category: "曲风",
    summary: "把音'弹歪'一点,为什么反而更动人?蓝调的苦味点开就懂。",
    sig: { kind: "notes", notes: ["C4", "Eb4", "F4", "Gb4", "G4", "Bb4"], timbre: "guitar" },
    sigNote: "正在听:布鲁斯音阶——「弹歪」的 ♭3 和 ♭5 两个蓝音,就是苦味的来源。",
  },
];

// 今日词条候选(带钩子文案,按日期轮换)
const DAILY = FEATURED.map((c) => ({
  title: c.title,
  category: c.category,
  hook: c.summary,
  href: c.href,
  sig: c.sig,
  sigNote: c.sigNote,
}));

// 入门路线五件套
const FEATURED_PATHS = ["guitar-intro", "piano-intro", "bass-intro", "ukulele-intro", "harmonica-intro"]
  .map((id) => paths.find((p) => p.id === id))
  .filter(Boolean);

const countByCategory = new Map(categories.map((c) => [c.label, 0]));
for (const e of entries) {
  const n = countByCategory.get(e.data.category);
  if (n !== undefined) countByCategory.set(e.data.category, n + 1);
}

// 全站互动组件种数:构建时扫描词条 MDX + pages + layouts 里对
// components/interactive 的 import 动态统计——词条用相对路径,页面/布局用
// @ 别名,两种都收。新组件接入任何一处,首页数字自动跟上(此前写死 14 早已过期)
const { readFileSync, readdirSync, statSync } = await import("node:fs");
const { join } = await import("node:path");
const walkAstro = (dir: string): string[] =>
  readdirSync(join(process.cwd(), dir)).flatMap((f) => {
    const p = join(dir, f);
    return statSync(join(process.cwd(), p)).isDirectory()
      ? walkAstro(p)
      : p.endsWith(".astro")
        ? [readFileSync(join(process.cwd(), p), "utf8")]
        : [];
  });
const interactiveSources = [
  ...entries.map((e) => e.body ?? ""),
  ...["src/pages", "src/layouts"].flatMap(walkAstro),
];
const interactiveCount = new Set(
  interactiveSources.flatMap((src) =>
    [
      ...src.matchAll(/from\s+"(?:\.\.\/)+components\/interactive\/([A-Za-z]+)"/g),
      ...src.matchAll(/from\s+"@\/components\/interactive\/([A-Za-z]+)"/g),
    ].map((m) => m[1]),
  ),
).size;
---

<BaseLayout
  title="橙月Wiki · 会发声的音乐百科"
  description="一本可交互的音乐百科全书 —— 乐理、记谱、曲风,边读边练。"
  ogImage="/og/index.png"
>
  <!-- Hero:价值主张当主角,品牌住在徽章里 -->
  <section class="border-b bg-linear-to-b from-surface/60 to-background">
    <div class="container py-14 md:py-24">
      <div class="hero-in inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1 text-sm text-muted-foreground">
        <img src="/logo.png" alt="" class="size-4 rounded-sm" />
        <span class="font-medium text-foreground">橙月Wiki</span>
        <span aria-hidden="true">·</span>
        <span>可交互的音乐百科</span>
      </div>

      <h1 class="hero-in hero-in-2 mt-6 text-4xl leading-tight font-display font-bold tracking-tight sm:text-5xl md:text-7xl">
        一本会 <PlayableWord client:load word="发声" /> 的
        <br class="hidden md:block" />音乐百科
      </h1>

      <p class="hero-in hero-in-2 mt-5 max-w-2xl text-lg text-muted-foreground md:text-xl">
        看不懂的地方,点一下就响给你听。
      </p>

      <div class="hero-in hero-in-3 mt-8 flex max-w-2xl flex-col gap-3 sm:flex-row sm:items-center">
        <div class="flex-1">
          <HomeSearch />
        </div>
        <a
          href="/paths"
          class="inline-flex items-center justify-center gap-1.5 rounded-full bg-primary px-6 py-3 text-sm font-medium whitespace-nowrap text-primary-foreground transition hover:opacity-90 active:scale-95"
        >
          从零开始学 →
        </a>
      </div>

      <div class="hero-in hero-in-3 mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
        <RandomEntryButton client:load slugs={entries.map((e) => e.id)} />
        <span aria-hidden="true">·</span>
        <span><strong class="font-mono tabular-nums text-foreground">{entries.length}</strong> 篇词条</span>
        <span><strong class="font-mono tabular-nums text-foreground">{paths.length}</strong> 条路线</span>
        <span><strong class="font-mono tabular-nums text-foreground">{interactiveCount}</strong> 个可交互演示</span>
      </div>

      <div class="hero-in hero-in-4 mt-10 max-w-4xl">
        <Piano
          client:visible
          startOct={4}
          octaves={2}
          keyHeight={256}
          minWidth={720}
          label="先玩一下 —— 点琴键听音。"
        />
      </div>

      <StaffLines class="mt-12 w-72 text-signature/60" />
    </div>
  </section>

  <!-- 今日词条 -->
  <section class="container pt-14">
    <div class="reveal">
      <DailyEntry client:load candidates={DAILY} />
    </div>
  </section>

  <!-- 分类:移动端 2 列大格(记号图标),平板 3 列,桌面回到一行 chips -->
  <section class="container pt-12">
    <div class="reveal">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-sm font-medium text-muted-foreground">词条分类</h2>
        <a href="/entries" class="text-sm text-muted-foreground hover:text-signature">全部 →</a>
      </div>
      <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3 md:flex md:flex-wrap md:items-center">
        {
          categories.map((c) => (
            <a
              href={`/categories/${c.id}`}
              style={`--cat:${catColor(c.hue)};--cat-d:${catColor(c.hue, "dark")}`}
              class="flex items-center gap-2.5 rounded-xl border bg-card px-4 py-3 text-sm transition hover:-translate-y-0.5 hover:border-signature/50 hover:bg-signature/10 hover:text-signature-ink active:scale-[0.98] md:gap-1.5 md:rounded-full md:py-1.5"
            >
              {/* 大格里放分类记号(记谱法图标),桌面 chip 收敛回色点 */}
              <svg
                viewBox="0 0 44 44"
                aria-hidden="true"
                class="size-8 shrink-0 text-(--cat) md:hidden dark:text-(--cat-d)"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                set:html={c.mark}
              />
              <span
                aria-hidden="true"
                class="mr-1.5 hidden size-1.5 rounded-full bg-(--cat) md:inline-block dark:bg-(--cat-d)"
              />
              <span class="font-medium md:font-normal">{c.label}</span>
              <span class="ml-auto text-xs tabular-nums text-muted-foreground md:ml-1.5">
                {countByCategory.get(c.label)}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 一首卡农,六种曲风:同一段旋律换风格包装 -->
  <section class="container pt-12 pb-16">
    <h2 class="reveal text-2xl font-display font-bold tracking-tight">一首卡农,六种曲风</h2>
    <p class="reveal mt-2 text-muted-foreground">
      帕赫贝尔卡农的和弦进行是无数流行歌的祖先。同一段旋律,点六个按钮换六种「包装」——曲风是什么,耳朵一听就懂。
    </p>
    <div class="reveal mt-8">
      <MelodyStyles client:visible />
    </div>
  </section>

  <!-- 听音猜曲风:盲听小测试 -->
  <section class="container pt-12 pb-16">
    <h2 class="reveal text-2xl font-display font-bold tracking-tight">听音猜曲风</h2>
    <p class="reveal mt-2 text-muted-foreground">
      刚听完卡农的六种包装?来盲听测试:随机一段曲风签名,四选一,连对越多耳朵越灵。
    </p>
    <div class="reveal mt-8">
      <GenreQuiz client:visible />
    </div>
  </section>

  <!-- 学习路线(入门五件套) -->
  <section class="container py-16">
    <div class="reveal flex items-end justify-between">
      <h2 class="text-2xl font-display font-bold tracking-tight">学习路线</h2>
      <a href="/paths" class="text-sm text-muted-foreground hover:text-signature"
        >全部 {paths.length} 条 →</a
      >
    </div>
    <p class="reveal mt-2 text-muted-foreground">从零到第一首歌,五件主流乐器各有一条 5 步路线。</p>
    <div class="reveal mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        FEATURED_PATHS.map((p) => (
          <a
            href={`/paths/${p!.id}`}
            class="group flex items-center gap-4 rounded-xl border bg-card p-5 transition hover:-translate-y-0.5 hover:border-signature/50 hover:shadow-md"
          >
            <div class="flex shrink-0 flex-col items-center justify-center rounded-lg bg-signature/10 px-4 py-2 text-signature-ink">
              <span class="text-2xl font-bold leading-none">{p!.data.steps.length}</span>
              <span class="text-xs">步</span>
            </div>
            <div class="min-w-0 flex-1">
              <div class="font-semibold group-hover:text-signature">{p!.data.title}</div>
              <div class="mt-1 line-clamp-2 text-sm text-muted-foreground">{p!.data.description}</div>
              <div class="mt-2 text-xs text-muted-foreground">
                第一步:{entryMap.get(p!.data.steps[0])?.data.title ?? "…"} →
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
