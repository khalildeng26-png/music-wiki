---
import BaseLayout from "@/layouts/BaseLayout.astro";

// 底鼓选型试听:多颗候选统一响度、零 EQ 修饰,原生 audio 直播裸文件。
const CANDIDATES = [
  { id: "e", name: "① 短尾紧凑型", desc: "0.3s 干脆收尾,鼓点感强,不拖泥" },
  { id: "f", name: "② 电子系 Serum", desc: "现代电子底鼓,冲击直接" },
  { id: "c2", name: "③ 80s 清脆型", desc: "复古紧拍,高频明显" },
  { id: "d", name: "④ 圆润标准型", desc: "传统录音底鼓,中低频均衡" },
];
---

<BaseLayout title="底鼓选型 · 橙月Wiki" description="底鼓候选试听">
  <section class="container py-12 max-w-2xl">
    <h1 class="text-2xl font-display font-bold tracking-tight">底鼓选型</h1>
    <p class="mt-2 text-muted-foreground">
      四颗候选(统一响度、无任何 EQ 修饰)+ 现役参考。每颗多点几遍,哪颗听着干净不糊就报编号。
      提示:浏览器播放器自带的进度条可以拖,不用等。
    </p>
    <div class="mt-8 space-y-5">
      {
        CANDIDATES.map((c) => (
          <div class="rounded-xl border bg-card p-4">
            <div class="font-medium">{c.name}</div>
            <div class="mt-0.5 text-sm text-muted-foreground">{c.desc}</div>
            <audio class="mt-3 w-full" controls preload="auto" src={`/audio/kick-audit/kick-${c.id}.mp3`} />
          </div>
        ))
      }
      <div class="rounded-xl border border-signature/40 bg-signature/5 p-4">
        <div class="font-medium">⑤ 现役参考(你反馈"糊"的这颗)</div>
        <div class="mt-0.5 text-sm text-muted-foreground">Subby 混合版 v2,用来对照</div>
        <audio class="mt-3 w-full" controls preload="auto" src="/audio/drums/kick.mp3" />
      </div>
    </div>
  </section>
</BaseLayout>
