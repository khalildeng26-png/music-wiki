---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EntryGroups from "@/components/EntryGroups.astro";
import CategoryFilter from "@/components/interactive/CategoryFilter";
import { getCollection } from "astro:content";
import { categories, catColor } from "@/lib/categories";

export async function getStaticPaths() {
  return categories.map((c) => ({
    params: { slug: c.id },
    props: { category: c },
  }));
}

const { category } = Astro.props;

const entries = (
  await getCollection("entries", (e) => !e.data.draft && e.data.category === category.label)
).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const paths = await getCollection("paths", (p) => !p.data.draft);
const seriesNames = Object.fromEntries(paths.map((p) => [p.id, p.data.title]));

// 分类内搜索的数据面(标题/译名/摘要/标签)
const filterItems = entries.map((e) => ({
  slug: e.id,
  title: e.data.title,
  titleEn: e.data.titleEn ?? "",
  summary: e.data.summary,
  tags: e.data.tags ?? [],
  kind: e.data.series ? ("tutorial" as const) : ("encyclopedia" as const),
  series: e.data.series ?? undefined,
}));
---

<BaseLayout title={`${category.label} · 橙月Wiki`} description={category.desc}>
  <section class="container py-12">
    <nav class="text-sm text-muted-foreground">
      <a href="/" class="hover:text-signature">首页</a>
      <span class="mx-1">/</span>
      <a href="/entries" class="hover:text-signature">词条</a>
    </nav>

    {/* 分类身份由色相承载:标题前一枚分类色点(旧记谱图标已删) */}
    <div
      class="mt-4 flex items-center gap-2.5"
      style={`--cat:${catColor(category.hue)};--cat-d:${catColor(category.hue, "dark")}`}
    >
      <span aria-hidden="true" class="size-2.5 shrink-0 rounded-full bg-(--cat) dark:bg-(--cat-d)"></span>
      <h1 class="text-3xl font-display font-bold tracking-tight">{category.label}</h1>
    </div>
    <p class="mt-2 text-muted-foreground">{category.desc}</p>

    {
      entries.length === 0 ? (
        <p class="mt-12 text-muted-foreground">这个分类下还没有词条,敬请期待。</p>
      ) : (
        <>
          <CategoryFilter client:load items={filterItems} seriesNames={seriesNames} />
          <div id="cat-static-list">
            <EntryGroups entries={entries} />
          </div>
        </>
      )
    }
  </section>
</BaseLayout>
