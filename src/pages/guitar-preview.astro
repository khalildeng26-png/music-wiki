---
// 组件预览页(未上线,不进导航):吉他组件效果自查看,顺便对照钢琴
import BaseLayout from "@/layouts/BaseLayout.astro";
import Guitar from "@/components/interactive/Guitar";
import Piano from "@/components/interactive/Piano";
---

<BaseLayout title="吉他组件预览 · 橙月Wiki">
  <main class="mx-auto max-w-4xl px-4 py-10 space-y-8">
    <header>
      <h1 class="text-2xl font-bold">吉他组件预览</h1>
      <p class="mt-1 text-sm text-muted-foreground">
        和弦机 + 指板联动(v1)。点头像旁的主题切换可看暗色模式效果。
      </p>
    </header>

    <Guitar client:visible label="常用和弦:点击扫弦,「1-6-4-5」听一段进行" />

    <Piano client:visible label="对照组:钢琴组件" keyHeight={160} />
  </main>
</BaseLayout>
